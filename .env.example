# ============================================
# FJKM Obligations - Configuration d'environnement
# ============================================
# Dupliquez ce fichier en .env et adaptez les valeurs
# Ne JAMAIS committer le fichier .env dans Git !
#
# Installation : copier ce fichier en .env puis modifier les valeurs
#   cp .env.example .env

# --- Environnement ---
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_NAME="GESTION D'OBLIGATION AU SEIN D'EGLISE FJKM MALAZA GILEADA"
APP_SHORT_NAME=FJKM Obligations
APP_TIMEZONE=Indian/Antananarivo
APP_LOCALE=fr_MG

# --- Base de données ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fjkm_obligation
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# --- Session & Sécurité ---
SESSION_NAME=FJKM_OBLIGATION_SESSION
REMEMBER_COOKIE=fjkm_remember_token
CSRF_KEY=_csrf_token
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15

# --- Uploads ---
UPLOAD_MAX_SIZE=2097152
ALLOWED_IMAGES=jpg,jpeg,png,webp
