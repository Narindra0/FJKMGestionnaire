{
  "name": "fjkm-malaza-gileada/gestion-obligation",
  "description": "Logiciel commercial MVC PHP pour la gestion des obligations financières FJKM Malaza Gileada.",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "dompdf/dompdf": "^3.0",
    "phpoffice/phpspreadsheet": "^2.1",
    "endroid/qr-code": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Core\\": "app/core/",
      "App\\Controllers\\": "app/controllers/",
      "App\\Middlewares\\": "app/middlewares/",
      "App\\Models\\": "app/models/",
      "App\\Services\\": "app/services/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8000 -t public"
  }
}
