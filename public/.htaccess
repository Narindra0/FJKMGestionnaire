# Commentaire technique
# Ce fichier contient des règles Apache pour protéger les dossiers,
# compresser les fichiers et orienter correctement les requêtes.

# ============================
# SÉCURITÉ
# ============================
<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "\.(env|env\.example|ini|log|sql|json|md)$">
    Require all denied
</FilesMatch>

# Cacher les fichiers de config
<FilesMatch "\.(git|gitignore|editorconfig|htaccess)$">
    Require all denied
</FilesMatch>

# Bloquer l'accès au dossier build
<Files "build.php">
    Require all denied
</Files>

# ============================
# COMPRESSION GZIP
# ============================
<IfModule mod_deflate.c>
    # Compresser HTML, CSS, JS, JSON, XML
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2

    # Exclure les fichiers déjà compressés
    SetEnvIfNoCase Request_URI \.(?:gz|zip)$ no-gzip
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp)$ no-gzip
</IfModule>

# ============================
# CACHE NAVIGATEUR
# ============================
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML — pas de cache (contenu dynamique)
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/php "access plus 0 seconds"

    # CSS/JS — cache 1 an (versions minifiées avec hash)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # Images — cache 1 mois
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonts — cache 1 an
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    # JSON/XML — cache 1 heure
    ExpiresByType application/json "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# ============================
# EN-TÊTES DE SÉCURITÉ
# ============================
<IfModule mod_headers.c>
    # Empêcher le sniffing de type MIME
    Header always set X-Content-Type-Options "nosniff"

    # Protection XSS
    Header always set X-XSS-Protection "1; mode=block"

    # Politique de referrer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy (désactiver les APIs inutiles)
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Cache pour les assets statiques
    <FilesMatch "\.(css|js|ico|gif|jpe?g|png|webp|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Pas de cache pour PHP/HTML
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# ============================
# PERFORMANCE
# ============================
<IfModule mod_headers.c>
    # Activer le Keep-Alive
    Header set Connection keep-alive

    # ETag optionnel (désactivé car hash dans l'URL suffit)
    <IfModule mod_expires.c>
        Header unset ETag
    </IfModule>
</IfModule>
